<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-consultations" author="telehealth">
        <createTable tableName="consultations">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="patient_id" type="uuid"><constraints nullable="false"/></column>
            <column name="doctor_id" type="uuid"/>
            <column name="type" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="required_specialization" type="varchar(50)"/>
            <column name="status" type="varchar(20)" defaultValue="PENDING"><constraints nullable="false"/></column>
            <column name="urgency_level" type="varchar(20)"/>
            <column name="patient_notes" type="varchar(1000)"/>
            <column name="patient_location" type="varchar(500)"/>
            <column name="patient_latitude" type="double precision" defaultValue="0.0"/>
            <column name="patient_longitude" type="double precision" defaultValue="0.0"/>
            <column name="requested_at" type="timestamp"/>
            <column name="scheduled_at" type="timestamp"/>
            <column name="started_at" type="timestamp"/>
            <column name="completed_at" type="timestamp"/>
            <column name="diagnosis" type="varchar(2000)"/>
            <column name="prescription" type="varchar(2000)"/>
            <column name="doctor_notes" type="varchar(2000)"/>
            <column name="patient_rating" type="double precision"/>
            <column name="cancellation_reason" type="varchar(500)"/>
            <column name="deleted" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp" defaultValueComputed="NOW()"><constraints nullable="false"/></column>
        </createTable>

        <createIndex tableName="consultations" indexName="idx_consultations_patient_id">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="consultations" indexName="idx_consultations_doctor_id">
            <column name="doctor_id"/>
        </createIndex>
        <createIndex tableName="consultations" indexName="idx_consultations_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
